#!/bin/sh

# Projects live beside this script, at ../projects.
LC_ALL=C
export LC_ALL
case $0 in
    */*) script=$0 ;;
    *) script=$(command -v -- "$0") || exit 1 ;;
esac
script_dir=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd) || exit 1
projects_dir=$script_dir/../projects

if [ ! -d "$projects_dir" ]; then
    printf 'Projects directory not found: %s\n' "$projects_dir" >&2
    exit 1
fi

for project in "$projects_dir"/* "$projects_dir"/.[!.]* "$projects_dir"/..?*; do
    [ -d "$project" ] || continue
    branch='(not a Git repository)'
    status=dirty
    # Require the child's own Git metadata; never discover the enclosing repo.
    if [ -e "$project/.git" ] &&
        git -C "$project" rev-parse --git-dir >/dev/null 2>&1; then
        if branch_name=$(git -C "$project" symbolic-ref --quiet --short HEAD 2>/dev/null); then
            branch=$branch_name
        elif commit=$(git -C "$project" rev-parse --short HEAD 2>/dev/null); then
            branch="(detached at $commit)"
        else
            branch='(HEAD unavailable)'
        fi
        if porcelain=$(git -C "$project" status --porcelain 2>/dev/null); then
            if [ -z "$porcelain" ]; then
                status=clean
            fi
        fi
    fi
    printf '%s\t%s\t%s\n' "$status" "${project##*/}" "$branch"
done | sort -t "$(printf '\t')" -k1,1 -k2,2 | awk -F '\t' '
    function table(label, n, names, branches,    i, project_width, branch_width) {
        project_width = length("PROJECT")
        branch_width = length("BRANCH")
        for (i = 1; i <= n; i++) {
            if (length(names[i]) > project_width) project_width = length(names[i])
            if (length(branches[i]) > branch_width) branch_width = length(branches[i])
        }
        printf "%s\n", label
        printf "%-*s  %s\n", project_width, "PROJECT", "BRANCH"
        for (i = 1; i <= n; i++)
            printf "%-*s  %s\n", project_width, names[i], branches[i]
    }
    $1 == "clean" {
        clean_n++
        clean_names[clean_n] = $2
        clean_branches[clean_n] = $3
        next
    }
    {
        dirty_n++
        dirty_names[dirty_n] = $2
        dirty_branches[dirty_n] = $3
    }
    END {
        table("CLEAN", clean_n, clean_names, clean_branches)
        printf "\n"
        table("DIRTY", dirty_n, dirty_names, dirty_branches)
    }
'
