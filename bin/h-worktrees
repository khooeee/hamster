#!/bin/sh

# Projects live beside this script, at ../projects.
# List every worktree of each project and the branch checked out there.
LC_ALL=C
export LC_ALL
case $0 in
    */*) script=$0 ;;
    *) script=$(command -v -- "$0") || exit 1 ;;
esac
script_dir=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd) || exit 1
projects_link=$script_dir/../projects

if [ ! -d "$projects_link" ]; then
    printf 'Projects directory not found: %s\n' "$projects_link" >&2
    exit 1
fi

projects_dir=$(CDPATH= cd -P -- "$projects_link" && pwd -P) || exit 1
mains=$(mktemp) || exit 1
linked=$(mktemp) || exit 1
porcelain=$(mktemp) || exit 1
trap 'rm -f "$mains" "$linked" "$porcelain"' EXIT

# Print one record for the worktree currently held in wt.
# Git lists the main worktree first.
emit() {
    [ -n "$wt" ] || return 0
    if [ "$bare" = 1 ]; then
        branch='(bare)'
    elif [ -n "$branch_ref" ]; then
        case $branch_ref in
            refs/heads/*) branch=${branch_ref#refs/heads/} ;;
            *) branch=$branch_ref ;;
        esac
    else
        if ! short=$(git -C "$wt" rev-parse --short HEAD 2>/dev/null); then
            short=$(printf '%.7s' "$head")
        fi
        branch="(detached at $short)"
    fi
    where=$wt
    prefix=$projects_dir/
    case $where in
        "$prefix"*) where=${where#"$prefix"} ;;
        *)
            if [ -n "$HOME" ]; then
                home_prefix=$HOME/
                case $where in
                    "$home_prefix"*) where="~/${where#"$home_prefix"}" ;;
                esac
            fi
            ;;
    esac
    if [ "$is_main" = 1 ]; then
        printf '%s\t%s\n' "$name" "$branch" >>"$mains"
        is_main=0
    else
        n=$((n + 1))
        printf '%s\t%s\t%s\t%s\n' "$name" "$n" "$branch" "$where" >>"$linked"
    fi
    wt=
}

for project in "$projects_link"/* "$projects_link"/.[!.]* "$projects_link"/..?*; do
    [ -d "$project" ] || continue
    name=${project##*/}
    # These directories hold linked worktrees; they are not projects.
    case $name in
        *.worktrees) continue ;;
    esac
    [ -e "$project/.git" ] || continue
    git -C "$project" rev-parse --git-dir >/dev/null 2>&1 || continue
    if ! git -C "$project" worktree list --porcelain >"$porcelain" 2>/dev/null; then
        printf '%s: unable to list worktrees\n' "$name" >&2
        continue
    fi

    wt=
    head=
    branch_ref=
    bare=0
    is_main=1
    n=0
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in
            '')
                emit
                head=
                branch_ref=
                bare=0
                ;;
            'worktree '*)
                emit
                wt=${line#'worktree '}
                head=
                branch_ref=
                bare=0
                ;;
            'HEAD '*)
                head=${line#'HEAD '}
                ;;
            'branch '*)
                branch_ref=${line#'branch '}
                ;;
            bare)
                bare=1
                ;;
            detached)
                branch_ref=
                ;;
        esac
    done <"$porcelain"
    emit
done

print_heading() {
    printf '%s\n' "$1"
    line=$1
    while [ -n "$line" ]; do
        printf '='
        line=${line#?}
    done
    printf '\n'
}

print_heading 'MAIN WORKTREE'
sort -t "$(printf '\t')" -k1,1 "$mains" | awk -F '\t' '
    BEGIN { width = length("PROJECT") }
    {
        names[NR] = $1
        branches[NR] = $2
        if (length($1) > width) width = length($1)
    }
    END {
        printf "%-*s  %s\n", width, "PROJECT", "BRANCH"
        for (i = 1; i <= NR; i++)
            printf "%-*s  %s\n", width, names[i], branches[i]
    }
'

printf '\n'
print_heading 'LINKED WORKTREES'
sort -t "$(printf '\t')" -k1,1 -k2,2n "$linked" | awk -F '\t' '
    BEGIN {
        project_width = length("PROJECT")
        branch_width = length("BRANCH")
    }
    {
        names[NR] = $1
        branches[NR] = $3
        folders[NR] = $4
        if (length($1) > project_width) project_width = length($1)
        if (length($3) > branch_width) branch_width = length($3)
    }
    END {
        printf "%-*s  %-*s  %s\n", project_width, "PROJECT", branch_width, "BRANCH", "FOLDER"
        for (i = 1; i <= NR; i++)
            printf "%-*s  %-*s  %s\n", project_width, names[i], branch_width, branches[i], folders[i]
    }
'
